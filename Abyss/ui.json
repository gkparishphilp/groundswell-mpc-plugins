{
  "kit": "violet",
  "pages": [
    { "name": "MAIN",
      "controls": [
        { "param": "Volume",  "widget": "fader" },
        { "param": "Evolve",  "widget": "knob" },
        { "param": "Bright",  "widget": "knob" },
        { "param": "Bloom",   "widget": "knob" },
        { "param": "Sub",     "widget": "fader" },
        { "param": "Fifth",   "widget": "fader" },
        { "param": "Shimmer", "widget": "fader" },
        { "param": "Air",     "widget": "fader" },
        { "param": "Drift",   "widget": "knob" },
        { "param": "Motion",  "widget": "knob" },
        { "param": "Detune",  "widget": "knob" },
        { "param": "Width",   "widget": "knob" },
        { "param": "Attack",  "widget": "fader" },
        { "param": "Release", "widget": "fader" },
        { "param": "Space",   "widget": "fader" },
        { "param": "Size",    "widget": "knob" }
      ] },
    { "name": "MOTION",
      "controls": [
        { "param": "Motion",    "widget": "knob" },
        { "param": "Sync",      "widget": "switch" },
        { "param": "Cycle",     "widget": "knob", "visibleWhen": { "param": "Sync", "choice": "Free" } },
        { "param": "Cycle Div", "widget": "slider", "overlay": "menu", "visibleWhen": { "param": "Sync", "choice": "Sync" } },
        { "param": "Evolve",    "widget": "knob" },
        { "param": "Drift",     "widget": "knob" },
        { "param": "Bloom",     "widget": "knob" },
        { "param": "Bright",    "widget": "knob" }
      ] },
    { "name": "SPACE",
      "controls": [
        { "param": "Space",      "widget": "fader" },
        { "param": "Size",       "widget": "knob" },
        { "param": "Space Tone", "widget": "knob" },
        { "param": "Width",      "widget": "knob" },
        { "param": "Octave",     "widget": "knob", "polarity": "bipolar" },
        { "param": "Velocity",   "widget": "knob" },
        { "param": "Attack",     "widget": "fader" },
        { "param": "Release",    "widget": "fader" }
      ] }
  ]
}
