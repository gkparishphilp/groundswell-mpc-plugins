{
  "kit": "cyan",
  "pages": [
    {
      "name": "FILTERS",
      "controls": [
        { "param": "A Type",  "widget": "slider", "overlay": "menu" },
        { "param": "A Freq",  "widget": "knob" },
        { "param": "A Reso",  "widget": "knob" },
        { "param": "Drive",   "widget": "knob" },
        { "param": "B Type",  "widget": "slider", "overlay": "menu" },
        { "param": "B Freq",  "widget": "knob" },
        { "param": "B Reso",  "widget": "knob" },
        { "param": "Routing", "widget": "switch" },
        { "param": "Breathe", "widget": "knob" },
        { "param": "Mix",     "widget": "fader" },
        { "param": "Output",  "widget": "fader" },
        "empty"
      ]
    },
    {
      "name": "MOVERS",
      "controls": [
        { "param": "Fol Attack",  "widget": "knob" },
        { "param": "Fol Release", "widget": "knob" },
        { "param": "Fol Gain",    "widget": "knob" },
