        "empty",
        "empty"
      ]
    },
    {
      "name": "DEPTH",
      "controls": [
        { "param": "Fol>A", "widget": "knob", "polarity": "bipolar" },
        { "param": "LFO>A", "widget": "knob", "polarity": "bipolar" },
        { "param": "Env>A", "widget": "knob", "polarity": "bipolar" },
        { "param": "A Freq", "widget": "knob" },
        { "param": "Fol>B", "widget": "knob", "polarity": "bipolar" },
        { "param": "LFO>B", "widget": "knob", "polarity": "bipolar" },
        { "param": "Env>B", "widget": "knob", "polarity": "bipolar" },
        { "param": "B Freq", "widget": "knob" }
      ]
